# .env.local 로 복사해 값을 채운다 — 값은 커밋하지 않는다
# 로컬 Supabase: `supabase start` 출력의 API URL · Publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 카카오 개발자 앱 › 플랫폼 키 › JavaScript 키 (JavaScript SDK 도메인에 localhost:3000 등록)
NEXT_PUBLIC_KAKAO_MAP_KEY=
# 카카오 개발자 앱 › 플랫폼 키 › REST API 키 (서버 전용 · 메뉴용 장소 맞추기에만, NEXT_PUBLIC 아님)
KAKAO_REST_API_KEY=

# 약관 · 처리방침 문의처 (공개 출시 전 필수)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=

# 서버 크론 전용 — 서비스 키(RLS 우회)는 Vercel 서버 환경에만, 브라우저 변수(NEXT_PUBLIC_)로 두지 않는다
SUPABASE_SECRET_KEY=
# Vercel Cron 이 Authorization: Bearer 로 보내는 값 — 임의의 긴 문자열
CRON_SECRET=

# 웹 푸시(VAPID) — `pnpm dlx web-push@3.6.7 generate-vapid-keys` 로 한 번 만들어 .env.local · Vercel 에 넣는다
# 공개 키는 브라우저에 실려도 되고, 비밀 키는 서버 전용. 키를 바꾸면 기존 구독은 모두 다시 켜야 한다
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 연락할 주소 — mailto:주소 또는 https://사이트
VAPID_SUBJECT=

# 업종 기본 그림 세트 — flat(평면, 기본) 또는 3d(입체). 바꾸면 다시 배포
NEXT_PUBLIC_FOOD_ART=flat
