# supabase/.env 로 복사해 값을 채운다 — 값은 커밋하지 않는다
# 카카오 개발자 앱: REST API 키 · 카카오 로그인 Client Secret (비즈 앱 + 이메일 동의항목 필요)
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=
# Google Cloud mychelin 프로젝트의 웹 OAuth 클라이언트
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# 네이버 개발자센터 앱 — pnpm auth:naver 가 읽어 custom:naver 로 등록 (ADR 0002)
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
