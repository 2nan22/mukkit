{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "crons": [
    { "path": "/api/cron/closure-check", "schedule": "0 18 * * *" },
    { "path": "/api/cron/import-refresh", "schedule": "0 19 * * *" }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false,
      "feat/**": false,
      "fix/**": false,
      "refactor/**": false,
      "chore/**": false,
      "docs/**": false
    }
  }
}
